# Configuração do servidor (Apache: KingHost, Hostinger, Locaweb etc.)

Options -Indexes
DirectoryIndex index.php

# app do painel (PWA)
<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache"
    Header set Service-Worker-Allowed "/clientes/crmteste/painel/"
  </Files>
</IfModule>

# ---------- endereço único: https + sem www (evita conteúdo duplicado no Google) ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  
  # sitemap para o Google (gerado a partir de config/empresa.php)
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# ---------- arquivos do repositório não devem ser públicos ----------
RedirectMatch 404 ^/clientes/crmteste/(README\.md|\.git.*|\.claude.*)$
RedirectMatch 404 ^/clientes/crmteste/api/(bootstrap|config|config\.example|webpush)\.php$
RedirectMatch 404 (?i)vendas-config\.php$
RedirectMatch 404 ^/clientes/crmteste/config/
RedirectMatch 404 ^/clientes/crmteste/painel/_[^/]*\.php$
# backups, logs, dumps de banco e arquivos ocultos nunca podem ser baixados
RedirectMatch 404 (?i)\.(sql|log|bak|old|orig|swp|ini|env|sh|lock|dist)$
RedirectMatch 404 /\.(?!well-known)

# ---------- cabeçalhos de segurança (site inteiro) ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always unset X-Powered-By
</IfModule>

# ---------- compressão ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---------- cache ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|webp|png)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# prévia: fora do Google
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
</IfModule>
